# Server Port
PORT=5000

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# InfluxDB Cloud Configuration
INFLUX_URL=your_influx_url
INFLUX_TOKEN_READ=your_influx_db_api_token_for_read_here
INFLUX_TOKEN_WRITE=your_influx_db_api_token_for_write_here
INFLUX_ORG=your_influx_organization_name_or_id
INFLUX_BUCKET=your_influx_bucket_name